rules_version = '2';

// ============================================================================
// REGRAS DE SEGURANÇA DO STORAGE — App G148
// ----------------------------------------------------------------------------
// Como aplicar: Firebase Console → Storage → aba "Regras" → colar este
// conteúdo → "Publicar". Só funciona depois de o projeto estar no plano
// Blaze (o Storage fica indisponível no Spark).
// ============================================================================

service firebase.storage {
  match /b/{bucket}/o {

    // Fotos de post do Mural / missões — só o dono da pasta pode enviar,
    // qualquer pessoa logada pode visualizar. Limite de 15MB por arquivo
    // como trava extra (a compressão do app já mira ~1MB, isso é só uma
    // rede de segurança contra upload de arquivo gigante por engano).
    match /fotos/{uid}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.auth.uid == uid
        && request.resource.size < 15 * 1024 * 1024;
    }

    // Áudios de oração/relato.
    match /audios/{uid}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.auth.uid == uid
        && request.resource.size < 20 * 1024 * 1024;
    }

    // Foto de perfil.
    match /perfil/{uid}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.auth.uid == uid
        && request.resource.size < 15 * 1024 * 1024;
    }

    // Fotos anexadas a mensagens do Correio (enviadas pelo Admin).
    match /correio/{uid}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.auth.uid == uid
        && request.resource.size < 15 * 1024 * 1024;
    }

    // Imagem circular de conquista (painel Admin > Conquistas). Só quem é
    // Admin (campo isAdmin no documento do usuário, no Firestore) pode
    // enviar; qualquer pessoa logada pode visualizar, porque o badge
    // aparece no perfil de todo mundo.
    match /conquistas/{conquistaId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.isAdmin == true
        && request.resource.size < 15 * 1024 * 1024;
    }

    // Materiais de estudo (painel Admin > Materiais, ícone de caixa no
    // Perfil) — capa (sempre imagem, corte 1:1) + conteúdo, que pode ser
    // uma outra imagem, um PDF, ou nada (quando o material é só um link
    // externo, ex.: Bíblia, Spotify, Drive). Só quem é Admin envia;
    // qualquer pessoa logada visualiza. Limite de 20MB (igual ao dos
    // áudios) — PDF de estudo cabe tranquilo nessa margem.
    match /materiais/{materialId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.isAdmin == true
        && request.resource.size < 20 * 1024 * 1024;
    }
  }
}
